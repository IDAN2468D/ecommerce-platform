# ==============================================================================
# Single Unified MongoDB Atlas Database Configuration (/mongodb-connection)
# Cluster: cluster0.purdk.mongodb.net
# Unified Database: ecommerce_db
# ==============================================================================
# Replace <username>, <password>, and <cluster-host> with your MongoDB Atlas SRV
# credentials, or set them in your local .env file:
#
# Connection Pool Parameters (OLTP Microservice + Java 21 Virtual Threads):
# - maxPoolSize=50              : Peak concurrent requests with 25% burst headroom
# - minPoolSize=10              : 10 pre-warmed connections to avoid TLS/SCRAM handshake latency
# - maxIdleTimeMS=300000        : 5 minutes retention for steady traffic
# - connectTimeoutMS=5000       : 5s fail-fast on TCP/TLS connection issues
# - socketTimeoutMS=30000       : 30s timeout for OLTP queries
# - serverSelectionTimeoutMS=5000 : 5s quick failover across Atlas 3-node Replica Set
# - waitQueueTimeoutMS=5000     : 5s fail-fast if pool is exhausted
# - retryWrites=true&w=majority : Atlas replica-set durability guarantee
# - uuidRepresentation=standard : Native RFC 4122 BSON Binary subtype 4 UUIDs
# ==============================================================================

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/ecommerce_db?retryWrites=true&w=majority&maxPoolSize=50&minPoolSize=10&maxIdleTimeMS=300000&connectTimeoutMS=5000&socketTimeoutMS=30000&serverSelectionTimeoutMS=5000&waitQueueTimeoutMS=5000&uuidRepresentation=standard
AUTH_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/ecommerce_db?retryWrites=true&w=majority&maxPoolSize=50&minPoolSize=10&maxIdleTimeMS=300000&connectTimeoutMS=5000&socketTimeoutMS=30000&serverSelectionTimeoutMS=5000&waitQueueTimeoutMS=5000&uuidRepresentation=standard
INVENTORY_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/ecommerce_db?retryWrites=true&w=majority&maxPoolSize=50&minPoolSize=10&maxIdleTimeMS=300000&connectTimeoutMS=5000&socketTimeoutMS=30000&serverSelectionTimeoutMS=5000&waitQueueTimeoutMS=5000&uuidRepresentation=standard
ORDER_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/ecommerce_db?retryWrites=true&w=majority&maxPoolSize=50&minPoolSize=10&maxIdleTimeMS=300000&connectTimeoutMS=5000&socketTimeoutMS=30000&serverSelectionTimeoutMS=5000&waitQueueTimeoutMS=5000&uuidRepresentation=standard
PAYMENT_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/ecommerce_db?retryWrites=true&w=majority&maxPoolSize=50&minPoolSize=10&maxIdleTimeMS=300000&connectTimeoutMS=5000&socketTimeoutMS=30000&serverSelectionTimeoutMS=5000&waitQueueTimeoutMS=5000&uuidRepresentation=standard

