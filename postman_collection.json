    {
      "name": "2. Orders Service",
      "description": "ניהול הזמנות ותזמור תהליך SAGA מלא",
      "item": [
        {
          "name": "Create Order (SAGA Flow)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "    var data = pm.response.json();",
                  "    if (data.orderId) {",
                  "        pm.collectionVariables.set(\"orderId\", data.orderId);",
                  "        console.log(\"Saved orderId to variable:\", data.orderId);",
                  "    }",
                  "    if (data.paymentTransactionId) {",
                  "        pm.collectionVariables.set(\"paymentTransactionId\", data.paymentTransactionId);",
                  "        console.log(\"Saved paymentTransactionId to variable:\", data.paymentTransactionId);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "description": "מזהה ייחודי למניעת חיובים והזמנות כפולות (מוגרל אוטומטית)"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currency\": \"ILS\",\n  \"paymentMethodToken\": \"pm_card_visa_demo\",\n  \"items\": [\n    {\n      \"skuCode\": \"IPHONE-16-PRO-256\",\n      \"quantity\": 1,\n      \"unitPrice\": 4899.00\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders"
              ]
            },
            "description": "יצירת הזמנה חדשה דרך ה-Gateway. מפעיל שריון מלאי, סליקת תשלום ואישור הזמנה."
          },
          "response": []
        },
        {
