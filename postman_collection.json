{
  "info": {
    "_postman_id": "a9e61234-582b-4fc4-bb11-477d9e7943c2",
    "name": "E-Commerce Microservices Platform",
    "description": "אוסף קריאות Postman מלא עבור פלטפורמת המיקרו-שירותים (Spring Boot 3, Java 21). כולל ניתוב דרך ה-API Gateway, תזמור SAGA, שאילתות מלאי, סליקה והתראות.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Automatically generate valid JWT signed with HMAC-SHA256 for order-service",
          "function base64url(source) {",
          "    var encodedSource = CryptoJS.enc.Base64.stringify(source);",
          "    encodedSource = encodedSource.replace(/=+$/, '');",
          "    encodedSource = encodedSource.replace(/\\+/g, '-');",
          "    encodedSource = encodedSource.replace(/\\//g, '_');",
          "    return encodedSource;",
          "}",
          "",
          "var header = { \"alg\": \"HS256\", \"typ\": \"JWT\" };",
          "var now = Math.floor(Date.now() / 1000);",
          "var payload = { \"sub\": \"usr_demo\", \"iat\": now, \"exp\": now + 86400 };",
          "",
          "var stringifiedHeader = CryptoJS.enc.Utf8.parse(JSON.stringify(header));",
          "var encodedHeader = base64url(stringifiedHeader);",
          "",
          "var stringifiedData = CryptoJS.enc.Utf8.parse(JSON.stringify(payload));",
          "var encodedData = base64url(stringifiedData);",
          "",
          "var token = encodedHeader + \".\" + encodedData;",
          "var secret = atob(\"b3JkZXItc2VydmljZS1kZWZhdWx0LXNlY3JldC1rZXktMzItYnl0ZXMhIQ==\");",
          "var signature = CryptoJS.HmacSHA256(token, secret);",
          "var encodedSignature = base64url(signature);",
          "",
          "var jwt = token + \".\" + encodedSignature;",
          "pm.variables.set(\"bearerToken\", jwt);"
        ]
      }
    }
  ],
