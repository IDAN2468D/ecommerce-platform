<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.3.5</version>
		<relativePath/>
	</parent>
	<groupId>com.company</groupId>
	<artifactId>ecommerce-platform</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>ecommerce-platform</name>
	<description>Production-Grade Distributed Microservices Platform</description>

	<properties>
		<java.version>21</java.version>
		<spring-cloud.version>2023.0.3</spring-cloud.version>
		<org.mapstruct.version>1.5.5.Final</org.mapstruct.version>
		<lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
		<springdoc.version>2.6.0</springdoc.version>
		<resilience4j.version>2.2.0</resilience4j.version>
		<wiremock.version>3.9.2</wiremock.version>
		<mcp-sdk.version>2.1.0</mcp-sdk.version>
	</properties>

	<modules>
		<module>common-events</module>
		<module>order-service</module>
		<module>inventory-service</module>
		<module>payment-service</module>
		<module>notification-service</module>
		<module>auth-service</module>
		<module>shipping-delivery-service</module>
		<module>review-rating-service</module>
		<module>cart-wishlist-service</module>
		<module>recommendation-loyalty-service</module>
		<module>workspace-integration-service</module>
		<module>api-gateway</module>
		<module>rag-service</module>
		<module>rma-returns-service</module>
		<module>dynamic-pricing-service</module>
		<module>fraud-risk-service</module>
		<module>merchant-analytics-service</module>
		<module>subscription-billing-service</module>
		<module>marketplace-vendor-service</module>
		<module>flash-sale-auction-service</module>
		<module>bnpl-credit-service</module>
		<module>group-buy-referral-service</module>
		<module>warranty-escrow-service</module>
		<module>trade-in-circular-service</module>
		<module>gift-registry-splitpay-service</module>
		<module>b2b-wholesale-quote-service</module>
		<module>rental-leasing-service</module>
		<module>customs-tax-duty-service</module>
		<module>custom-configurator-service</module>
		<module>omnifillment-locker-service</module>
		<module>field-installation-service</module>
		<module>carbon-sustainability-service</module>
		<module>digital-wallet-giftcard-service</module>
		<module>creator-affiliate-live-service</module>
	</modules>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<configuration>
						<source>21</source>
						<target>21</target>
						<annotationProcessorPaths>
							<path>
								<groupId>org.projectlombok</groupId>
								<artifactId>lombok</artifactId>
								<version>${lombok.version}</version>
							</path>
							<path>
								<groupId>org.projectlombok</groupId>
								<artifactId>lombok-mapstruct-binding</artifactId>
								<version>${lombok-mapstruct-binding.version}</version>
							</path>
							<path>
								<groupId>org.mapstruct</groupId>
								<artifactId>mapstruct-processor</artifactId>
								<version>${org.mapstruct.version}</version>
							</path>
						</annotationProcessorPaths>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>
</project>
